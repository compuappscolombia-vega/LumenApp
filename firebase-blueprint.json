{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado y configuración persistente del cineasta o productor autenticado en LumenReel Studio.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID de Firebase Auth del usuario propietario."
        },
        "displayName": {
          "type": "string",
          "description": "Nombre del director o productor (1..120 caracteres)."
        },
        "email": {
          "type": "string",
          "description": "Correo electrónico de Google Sign-In (3..200 caracteres)."
        },
        "preferredStyle": {
          "type": "string",
          "description": "Estilo cinematográfico preferido opcional (<=160 caracteres)."
        },
        "themeMode": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "Tema visual global preferido del usuario."
        },
        "defaultAspectRatio": {
          "type": "string",
          "enum": ["2.39:1", "1.85:1", "16:9", "1.43:1"],
          "description": "Relación de aspecto por defecto para nuevas secuencias."
        },
        "defaultThinkingDepth": {
          "type": "string",
          "enum": ["STANDARD", "DEEP"],
          "description": "Profundidad de análisis por defecto."
        },
        "autoSaveDrafts": {
          "type": "boolean",
          "description": "Si está activo, guarda borradores de trabajo localmente entre sesiones."
        },
        "stage3DDefault": {
          "type": "boolean",
          "description": "Define si el escenario 3D está activo por defecto en Planos."
        },
        "lastProjectId": {
          "type": "string",
          "description": "Último proyecto abierto."
        },
        "lastSequenceId": {
          "type": "string",
          "description": "Última secuencia abierta."
        },
        "lastTab": {
          "type": "string",
          "description": "Última pestaña activa en el espacio de trabajo."
        },
        "role": {
          "type": "string",
          "enum": ["director"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor (FieldValue.serverTimestamp)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor (FieldValue.serverTimestamp)."
        }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "StudioProject": {
      "title": "StudioProject",
      "description": "Proyecto cinematográfico independiente almacenado para un usuario.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID del propietario."
        },
        "title": {
          "type": "string",
          "description": "Título de la producción (1..180 caracteres)."
        },
        "genreStyle": {
          "type": "string",
          "description": "Género o estilo visual (<=180 caracteres)."
        },
        "defaultSourceType": {
          "type": "string",
          "enum": ["book", "audiobook", "story"]
        },
        "continuityBible": {
          "type": "string",
          "description": "Biblia de continuidad acumulada (<=20000 caracteres)."
        },
        "templateId": {
          "type": "string",
          "description": "Identificador de plantilla cinematográfica inicial (<=64 caracteres)."
        },
        "productionFolders": {
          "type": "array",
          "description": "Carpetas de producción inicializadas automáticamente según la plantilla elegida, con notas y linkedSequenceIds para organizar guiones y storyboards (<=20)."
        },
        "sequencesCount": {
          "type": "integer",
          "description": "Cantidad de secuencias (0..1000)."
        },
        "assetsCount": {
          "type": "integer",
          "description": "Cantidad de recursos adjuntos (0..5000)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor (FieldValue.serverTimestamp)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor (FieldValue.serverTimestamp)."
        }
      },
      "required": [
        "ownerId",
        "title",
        "genreStyle",
        "defaultSourceType",
        "continuityBible",
        "sequencesCount",
        "assetsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectSequence": {
      "title": "ProjectSequence",
      "description": "Secuencia producida dentro de un proyecto, con estado borrador o versión final.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "description": "ID del proyecto padre."
        },
        "ownerId": {
          "type": "string",
          "description": "UID del propietario."
        },
        "title": {
          "type": "string",
          "description": "Título de la secuencia (1..200 caracteres)."
        },
        "versionStatus": {
          "type": "string",
          "enum": ["draft", "final"]
        },
        "sourceType": {
          "type": "string",
          "enum": ["book", "audiobook", "story"]
        },
        "directorStyle": {
          "type": "string",
          "description": "Firma cinematográfica (<=180 caracteres)."
        },
        "aspectRatio": {
          "type": "string",
          "description": "Relación de aspecto (<=24 caracteres)."
        },
        "logline": {
          "type": "string",
          "description": "Logline dramático (<=1200 caracteres)."
        },
        "directorVision": {
          "type": "string",
          "description": "Visión de dirección (<=6000 caracteres)."
        },
        "continuitySummary": {
          "type": "string",
          "description": "Resumen de continuidad (<=3000 caracteres)."
        },
        "sequenceRating": {
          "type": "integer",
          "description": "Valoración opcional de Studio Intelligence (1..5)."
        },
        "sequenceData": {
          "type": "object",
          "description": "Mapa nativo con cámara, paleta, iluminación, planos, sonido, informe de audio, VFX, guion y storyboard."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor (FieldValue.serverTimestamp)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor (FieldValue.serverTimestamp)."
        }
      },
      "required": [
        "projectId",
        "ownerId",
        "title",
        "versionStatus",
        "sourceType",
        "directorStyle",
        "aspectRatio",
        "logline",
        "directorVision",
        "continuitySummary",
        "sequenceData",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProductionMilestone": {
      "title": "ProductionMilestone",
      "description": "Hito, día de rodaje, entrega o revisión programada en el calendario de producción de un proyecto.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "dateMillis": { "type": "integer" },
        "milestoneType": {
          "type": "string",
          "enum": ["shooting_day", "deadline", "review", "premiere"]
        },
        "sequenceId": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "projectId",
        "ownerId",
        "title",
        "notes",
        "dateMillis",
        "milestoneType",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoryboardAsset": {
      "title": "StoryboardAsset",
      "description": "Ruta persistida de fotograma Nano generado para una tarjeta de storyboard (compatible con secuencias en borrador y versión final).",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "ownerId": { "type": "string" },
        "sequenceId": { "type": "string" },
        "frameId": { "type": "string" },
        "localImagePath": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "ownerId", "sequenceId", "frameId", "localImagePath", "updatedAt"]
    },
    "AgentMessage": {
      "title": "AgentMessage",
      "description": "Turno de conversación entre el productor y el Agente Cinematográfico Tripartito.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["user", "agent"]
        },
        "focus": {
          "type": "string",
          "enum": ["council", "director", "screenwriter", "vfx"]
        },
        "content": {
          "type": "string"
        },
        "actions": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["projectId", "ownerId", "role", "focus", "content", "createdAt"]
    },
    "LearningLesson": {
      "title": "LearningLesson",
      "description": "Lección de autoaprendizaje y mejora continua extraída de evaluaciones o producciones finales.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": ["camera", "lighting", "sound", "screenplay", "pacing", "continuity"]
        },
        "insight": {
          "type": "string"
        },
        "rating": {
          "type": "integer"
        },
        "sourceProjectTitle": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "category", "insight", "rating", "sourceProjectTitle", "createdAt"]
    },
    "ScriptVersion": {
      "title": "ScriptVersion",
      "description": "Instantánea versionada de un guion dentro de un proyecto cinematográfico para guardar y alternar revisiones en Cloud Firestore.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "ownerId": { "type": "string" },
        "sequenceId": { "type": "string" },
        "sequenceTitle": { "type": "string" },
        "versionNumber": { "type": "integer" },
        "versionLabel": { "type": "string" },
        "changeNote": { "type": "string" },
        "sceneCount": { "type": "integer" },
        "wordCount": { "type": "integer" },
        "scenes": {
          "type": "array",
          "description": "Lista de escenas (ScreenplayScene) guardadas en esta versión."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "projectId",
        "ownerId",
        "sequenceId",
        "sequenceTitle",
        "versionNumber",
        "versionLabel",
        "changeNote",
        "sceneCount",
        "wordCount",
        "scenes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfil privado y configuración del usuario autenticado (PII aislada por propietario)."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/StudioProject" },
      "description": "Proyectos cinematográficos del usuario."
    },
    "/users/{userId}/projects/{projectId}/sequences/{sequenceId}": {
      "schema": { "$ref": "#/entities/ProjectSequence" },
      "description": "Secuencias y expedientes cinematográficos dentro de un proyecto."
    },
    "/users/{userId}/projects/{projectId}/script_versions/{versionId}": {
      "schema": { "$ref": "#/entities/ScriptVersion" },
      "description": "Historial de versiones de guion guardadas por proyecto para alternar revisiones."
    },
    "/users/{userId}/projects/{projectId}/milestones/{milestoneId}": {
      "schema": { "$ref": "#/entities/ProductionMilestone" },
      "description": "Hitos y días de rodaje del calendario de producción de un proyecto."
    },
    "/users/{userId}/projects/{projectId}/storyboard_assets/{assetId}": {
      "schema": { "$ref": "#/entities/StoryboardAsset" },
      "description": "Fotogramas Nano generados para tarjetas de storyboard."
    },
    "/users/{userId}/projects/{projectId}/agent_messages/{messageId}": {
      "schema": { "$ref": "#/entities/AgentMessage" },
      "description": "Historial de mensajes del Agente Tripartito por proyecto."
    },
    "/users/{userId}/learning_memory/{lessonId}": {
      "schema": { "$ref": "#/entities/LearningLesson" },
      "description": "Memoria de autoaprendizaje y mejora continua del productor cinematográfico."
    }
  }
}
