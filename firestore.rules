rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Helpers ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'preferredStyle',
          'themeMode', 'defaultAspectRatio', 'defaultThinkingDepth',
          'autoSaveDrafts', 'stage3DDefault',
          'lastProjectId', 'lastSequenceId', 'lastTab',
          'role', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role == 'director'
        && (!('preferredStyle' in data) || (data.preferredStyle is string && data.preferredStyle.size() <= 160))
        && (!('themeMode' in data) || (data.themeMode in ['dark', 'light']))
        && (!('defaultAspectRatio' in data) || (data.defaultAspectRatio in ['2.39:1', '1.85:1', '16:9', '1.43:1']))
        && (!('defaultThinkingDepth' in data) || (data.defaultThinkingDepth in ['STANDARD', 'DEEP']))
        && (!('autoSaveDrafts' in data) || (data.autoSaveDrafts is bool))
        && (!('stage3DDefault' in data) || (data.stage3DDefault is bool))
        && (!('lastProjectId' in data) || (data.lastProjectId is string && data.lastProjectId.size() <= 128))
        && (!('lastSequenceId' in data) || (data.lastSequenceId is string && data.lastSequenceId.size() <= 128))
        && (!('lastTab' in data) || (data.lastTab is string && data.lastTab.size() <= 40))
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudioProject(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'genreStyle', 'defaultSourceType',
          'continuityBible', 'sequencesCount', 'assetsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'genreStyle', 'defaultSourceType',
          'continuityBible', 'templateId', 'productionFolders',
          'sequencesCount', 'assetsCount', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.genreStyle is string && data.genreStyle.size() <= 180
        && data.defaultSourceType in ['book', 'audiobook', 'story']
        && data.continuityBible is string && data.continuityBible.size() <= 20000
        && (!('templateId' in data) || (data.templateId is string && data.templateId.size() <= 64))
        && (!('productionFolders' in data) || (
          data.productionFolders is list
          && data.productionFolders.size() <= 20
          && (data.productionFolders.size() == 0 || data.productionFolders[0] is map)
        ))
        && data.sequencesCount is int && data.sequencesCount >= 0 && data.sequencesCount <= 1000
        && data.assetsCount is int && data.assetsCount >= 0 && data.assetsCount <= 5000
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProjectSequence(data, userId, projectId) {
      return data.keys().hasAll([
          'projectId', 'ownerId', 'title', 'versionStatus', 'sourceType',
          'directorStyle', 'aspectRatio', 'logline', 'directorVision',
          'continuitySummary', 'sequenceData', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'projectId', 'ownerId', 'title', 'versionStatus', 'sourceType',
          'directorStyle', 'aspectRatio', 'logline', 'directorVision',
          'continuitySummary', 'sequenceRating', 'sequenceData', 'createdAt', 'updatedAt'
        ])
        && data.projectId == projectId
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.versionStatus in ['draft', 'final']
        && data.sourceType in ['book', 'audiobook', 'story']
        && data.directorStyle is string && data.directorStyle.size() <= 180
        && data.aspectRatio is string && data.aspectRatio.size() <= 24
        && data.logline is string && data.logline.size() <= 1200
        && data.directorVision is string && data.directorVision.size() <= 6000
        && data.continuitySummary is string && data.continuitySummary.size() <= 3000
        && (!('sequenceRating' in data) || (data.sequenceRating is int && data.sequenceRating >= 1 && data.sequenceRating <= 5))
        && data.sequenceData is map
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMilestone(data, userId, projectId) {
      return data.keys().hasAll([
          'projectId', 'ownerId', 'title', 'notes', 'dateMillis',
          'milestoneType', 'completed', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'projectId', 'ownerId', 'title', 'notes', 'dateMillis',
          'milestoneType', 'sequenceId', 'completed', 'createdAt', 'updatedAt'
        ])
        && data.projectId == projectId
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.notes is string && data.notes.size() <= 1000
        && data.dateMillis is int && data.dateMillis > 0
        && data.milestoneType in ['shooting_day', 'deadline', 'review', 'premiere']
        && (!('sequenceId' in data) || (data.sequenceId is string && data.sequenceId.size() <= 128))
        && data.completed is bool
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStoryboardAsset(data, userId, projectId) {
      return data.keys().hasAll([
          'projectId', 'ownerId', 'sequenceId', 'frameId', 'localImagePath', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'projectId', 'ownerId', 'sequenceId', 'frameId', 'localImagePath', 'updatedAt'
        ])
        && data.projectId == projectId
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.sequenceId is string && data.sequenceId.size() >= 1 && data.sequenceId.size() <= 128
        && data.frameId is string && data.frameId.size() >= 1 && data.frameId.size() <= 128
        && data.localImagePath is string && data.localImagePath.size() >= 1 && data.localImagePath.size() <= 1000
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAgentMessage(data, userId, projectId) {
      return data.keys().hasAll([
          'projectId', 'ownerId', 'role', 'focus', 'content', 'createdAt'
        ])
        && data.keys().hasOnly([
          'projectId', 'ownerId', 'role', 'focus', 'content', 'actions', 'createdAt'
        ])
        && data.projectId == projectId
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.role in ['user', 'agent']
        && data.focus in ['council', 'director', 'screenwriter', 'vfx']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 12000
        && (!('actions' in data) || (data.actions is list && data.actions.size() <= 10 && (data.actions.size() == 0 || data.actions[0] is map)))
        && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLearningLesson(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'category', 'insight', 'rating', 'sourceProjectTitle', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'category', 'insight', 'rating', 'sourceProjectTitle', 'createdAt'
        ])
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.category in ['camera', 'lighting', 'sound', 'screenplay', 'pacing', 'continuity']
        && data.insight is string && data.insight.size() >= 5 && data.insight.size() <= 1000
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.sourceProjectTitle is string && data.sourceProjectTitle.size() <= 180
        && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'preferredStyle',
          'themeMode', 'defaultAspectRatio', 'defaultThinkingDepth',
          'autoSaveDrafts', 'stage3DDefault',
          'lastProjectId', 'lastSequenceId', 'lastTab',
          'updatedAt'
        ]);
      allow delete: if false;

      match /projects/{projectId} {
        allow get: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(projectId)
          && isOwner(userId)
          && isValidStudioProject(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(projectId)
          && isOwner(userId)
          && isValidStudioProject(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'genreStyle', 'continuityBible', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['sequencesCount', 'assetsCount', 'continuityBible', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['continuityBible', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['productionFolders', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(projectId) && isOwner(userId);

        match /sequences/{sequenceId} {
          allow get: if isValidId(userId) && isValidId(projectId) && isValidId(sequenceId) && isOwner(userId);
          allow list: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
          allow create: if isValidId(userId) && isValidId(projectId) && isValidId(sequenceId)
            && isOwner(userId)
            && isValidProjectSequence(incoming(), userId, projectId)
            && exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));
          allow update: if isValidId(userId) && isValidId(projectId) && isValidId(sequenceId)
            && isOwner(userId)
            && isValidProjectSequence(incoming(), userId, projectId)
            && incoming().projectId == existing().projectId
            && incoming().ownerId == existing().ownerId
            && incoming().createdAt == existing().createdAt
            && (
              (existing().versionStatus == 'draft'
                && incoming().versionStatus == 'final'
                && incoming().diff(existing()).affectedKeys().hasOnly(['versionStatus', 'updatedAt']))
              || (existing().versionStatus == 'draft'
                && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'logline', 'directorVision', 'sequenceData', 'continuitySummary', 'updatedAt']))
              || (incoming().diff(existing()).affectedKeys().hasOnly(['sequenceRating', 'updatedAt']))
            );
          allow delete: if isValidId(userId) && isValidId(projectId) && isValidId(sequenceId)
            && isOwner(userId)
            && existing().versionStatus == 'draft';
        }

        match /milestones/{milestoneId} {
          allow get: if isValidId(userId) && isValidId(projectId) && isValidId(milestoneId) && isOwner(userId);
          allow list: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
          allow create: if isValidId(userId) && isValidId(projectId) && isValidId(milestoneId)
            && isOwner(userId)
            && isValidMilestone(incoming(), userId, projectId)
            && exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));
          allow update: if isValidId(userId) && isValidId(projectId) && isValidId(milestoneId)
            && isOwner(userId)
            && isValidMilestone(incoming(), userId, projectId)
            && incoming().projectId == existing().projectId
            && incoming().ownerId == existing().ownerId
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'completed', 'title', 'notes', 'dateMillis', 'milestoneType', 'sequenceId', 'updatedAt'
            ]);
          allow delete: if isValidId(userId) && isValidId(projectId) && isValidId(milestoneId) && isOwner(userId);
        }

        match /storyboard_assets/{assetId} {
          allow get: if isValidId(userId) && isValidId(projectId) && isValidId(assetId) && isOwner(userId);
          allow list: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
          allow create: if isValidId(userId) && isValidId(projectId) && isValidId(assetId)
            && isOwner(userId)
            && isValidStoryboardAsset(incoming(), userId, projectId)
            && exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));
          allow update: if isValidId(userId) && isValidId(projectId) && isValidId(assetId)
            && isOwner(userId)
            && isValidStoryboardAsset(incoming(), userId, projectId)
            && incoming().projectId == existing().projectId
            && incoming().ownerId == existing().ownerId;
          allow delete: if isValidId(userId) && isValidId(projectId) && isValidId(assetId) && isOwner(userId);
        }

        match /agent_messages/{messageId} {
          allow get: if isValidId(userId) && isValidId(projectId) && isValidId(messageId) && isOwner(userId);
          allow list: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
          allow create: if isValidId(userId) && isValidId(projectId) && isValidId(messageId)
            && isOwner(userId)
            && isValidAgentMessage(incoming(), userId, projectId)
            && exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));
          allow update: if false;
          allow delete: if isValidId(userId) && isValidId(projectId) && isValidId(messageId) && isOwner(userId);
        }
      }

      match /learning_memory/{lessonId} {
        allow get: if isValidId(userId) && isValidId(lessonId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(lessonId)
          && isOwner(userId)
          && isValidLearningLesson(incoming(), userId);
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(lessonId) && isOwner(userId);
      }
    }
  }
}
